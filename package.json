{
  "name": "thought-carry",
  "version": "0.1.0",
  "description": "Provider-agnostic round-tripping for opaque reasoning signatures (Gemini thoughtSignature, Anthropic signed thinking blocks, OpenAI encrypted_content) across multi-turn tool calling",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gemini",
    "anthropic",
    "openai",
    "thinking",
    "reasoning",
    "tool-use",
    "function-calling"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
